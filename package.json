{
  "name": "blipmood",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "check": "node scripts/run-checks.mjs",
    "build": "npm run check && node scripts/build-site.mjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "npm run build && playwright test",
    "check:cloudflare-media": "node --test tests/cloudflare-r2-media-worker.test.cjs",
    "check:cloudflare-free": "node --test tests/cloudflare-workers-free.test.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "dompurify": "3.4.17",
    "rss-parser": "3.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "pgsql-parser": "18.2.9"
  }
}
